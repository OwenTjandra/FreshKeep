# Server
PORT=3000

# Postgres — local dev default; production uses Railway/Render connection string
DATABASE_URL=postgres://localhost:5432/freshkeep

# Anthropic — for recipe generation (Step 12). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Open Food Facts — public API, no key needed but they ask for a User-Agent identifying your app
OPEN_FOOD_FACTS_USER_AGENT=FreshKeep/0.1

# Firebase — for FCM push notifications (Step 14). Path to a downloaded
# service-account JSON. When unset, the notifications service logs intended
# sends instead of pushing — useful for local dev.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Notifications scheduler — set to "true" to run the every-5-min cron that
# checks for users in their 8–10am local window. Off by default so local dev
# isn't surprised by background activity.
NOTIFICATIONS_ENABLED=false
